# Fstab
ro.postinstall.fstab.prefix=/system

# USB MTP
ro.sys.usb.storage.type=mtp

# Crypto
ro.crypto.volume.filenames_mode=aes-256-cts
ro.crypto.dm_default_key.options_format.version=2
ro.crypto.volume.metadata.method=dm-default-key

# TEE
ro.vendor.mtk_tee_gp_support=1
ro.vendor.mtk_microtrust_tee_support=1

# Gatekeeper
ro.hardware.gatekeeper=beanpod

# HyperOS 2.0.5 Properties
ro.miui.ui.version.code=14
ro.miui.ui.version.name=V140
ro.product.mod_device=rubens_global
ro.build.ab_update=true

# Display
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.running_without_sync_framework=true
ro.surface_flinger.vsync_event_phase_offset_ns=2000000
ro.surface_flinger.vsync_sf_event_phase_offset_ns=6000000

# Performance
ro.vendor.perf.scroll_opt=true
ro.config.avoid_gfx_accel=true

# Thermal
ro.config.per_app_memcg=false
